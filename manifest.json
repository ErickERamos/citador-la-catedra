{
  "manifest_version": 3,
  "name": "Citador La Cátedra",
  "version": "1.0.0",
  "description": "Genera citas en formato APA 7ma edición desde cualquier página web. Herramienta académica de La Cátedra.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
